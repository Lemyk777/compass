# Normalise line endings. Without this, every commit from Windows prints
# "LF will be replaced by CRLF" warnings and diffs pick up whole-file changes
# when the same file is touched from a different machine.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated or vendored — keep them out of diff noise and language stats.
package-lock.json -diff linguist-generated
reasoning-traces/** linguist-generated
data-pipeline/** linguist-documentation
