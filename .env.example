NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never sent to client
ANTHROPIC_API_KEY=                # server-only
CRON_SECRET=                      # server-only, protects /api/cron/* endpoints (set in Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=          # optional, production only — the token from Search Console's
                                   # "HTML tag" method, without the surrounding markup. Absent, no
                                   # tag is rendered and nothing else changes.
